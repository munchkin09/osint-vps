# VPS and SSH
ADMIN_SSH_PORT=2222

# Redis
REDIS_URL=redis://redis:6379
RAW_STREAM=events:raw
ENRICHED_STREAM=events:enriched

# OpenSearch
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=change-me-to-a-long-random-password
OPENSEARCH_INITIAL_ADMIN_PASSWORD=change-me-to-a-long-random-password
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_PREFIX=cto-events

# Optional local enrichment
GEOIP_DB_PATH=

# Optional external OSINT APIs
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# Worker behavior
DNS_TIMEOUT_SECONDS=1.5
WHOIS_ENABLED=false
OSINT_TIMEOUT_SECONDS=3
LOG_LEVEL=INFO
